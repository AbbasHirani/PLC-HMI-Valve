        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="en-US">Any of the four flags above. One bit for a screen to watch instead of ORing four.</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="LastUnknownLaddr" Datatype="UInt" Remanence="NonRetain" Accessibility="Public">
