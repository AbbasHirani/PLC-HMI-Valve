    <Member Name="FwdLost" Datatype="Bool" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="en-US">ET200SP_FWD is off the network. Valves 55-89 are unreachable.</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="UnknownLost" Datatype="Bool" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="en-US">A station failed whose hardware identifier matches none of the three above. Means either the identifiers were reassigned and this DB was not updated, or a device exists that OB86 does not know about. Never silently ignored - that would hide a real station failure.</MultiLanguageText>
