    <ObjectList>
      <MultilingualText ID="1" CompositionName="Comment">
        <ObjectList>
          <MultilingualTextItem ID="2" CompositionName="Items">
            <AttributeList>
              <Culture>en-US</Culture>
              <Text>Called by the CPU when an I/O module reports a diagnostic. FC_ModuleEvent sets or clears that module's bit in Diag_DB.W_ModuleFault, which drives its alarm.</Text>
            </AttributeList>
          </MultilingualTextItem>
        </ObjectList>
      </MultilingualText>
      <SW.Blocks.CompileUnit ID="3" CompositionName="CompileUnits">
        <AttributeList>
          <NetworkSource><StructuredText xmlns="http://www.siemens.com/automation/Openness/SW/NetworkSource/StructuredText/v4">
  <Text UId="1">
// Called by the CPU when an I/O module raises a diagnostic: its 24 V supply missing or low,
// a DQ output short-circuited to L+ or to ground, a parameter error, or a wire break where
// that is ever enabled. Those diagnostics ship DISABLED; they were switched on across all
// 36 modules on 2026-09-06.
//
// The same OB should fire when a fault appears and when it goes away, and #IO_State says which.
// FC_ModuleEvent does the work immediately, on every call, so several modules reporting
// together cannot overwrite one another.
//
// PLCSIM cannot trigger this block. Prove it on the real panel: cut a module's supply and
// confirm its alarm raises, restore it and confirm the alarm clears.
#id := #LADDR;
"FC_ModuleEvent"(Laddr := #id, IoState := #IO_State);

// Raw copy of the most recent event, for diagnosis. Reports only the LAST event - the per-module
// bits are the record of what is faulted. The DQ datasheet lists its diagnostics as module-wise,
// so do not expect Channel to identify a terminal until the panel shows otherwise.
"Diag_DB".LastModuleLaddr := #id;
"Diag_DB".LastModuleIoState := #IO_State;
"Diag_DB".LastModuleChannel := #Channel;
"Diag_DB".LastModuleMultiError := #MultiError;

// Saturating, not wrapping: an Int rolling negative would read as a different kind of fault.
// A count rising steadily means a module is chattering.
IF "Diag_DB".ModuleEventCount &lt; 32767 THEN
    "Diag_DB".ModuleEventCount := "Diag_DB".ModuleEventCount + 1;
END_IF;
  </Text>
</StructuredText></NetworkSource>
