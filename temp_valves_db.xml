      <Sections>
        <Section Name="None">
          <Member Name="PT" Datatype="Time" />
          <Member Name="ET" Datatype="Time" />
          <Member Name="IN" Datatype="Bool" />
          <Member Name="Q" Datatype="Bool" />
        </Section>
      </Sections>
    </Member>
    <!-- 5-second grace before the direction/limit discrepancy (H) fires. The grace is the whole
         trick: a valve leaving a fully-open seat legitimately holds OpenFB made for the first
         moment of a close, so an instant check would false-trip on every normal stroke. 5s (not
         the 3s first considered) because a false alarm in week one costs more operator trust than
         a true one two seconds later - retune per valve at commissioning alongside the travel
         timeout (both are currently one-size-fits-all and both should not be; see handoff item 13).
         One timer serves both directions: OpenValve and CloseValve are mutually exclusive by
         construction, so they can never both need it in the same scan. -->
    <Member Name="DirTmr" Datatype="Array[1..89] of TON_TIME" Version="1.0" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
      <Sections>
        <Section Name="None">
