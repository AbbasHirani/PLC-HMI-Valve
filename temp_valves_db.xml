    <!-- What the mimic box should show RIGHT NOW, flashing included. 0=unconfigured 1=red(fault half of
         the flash) 2=local 3..7=position. The alternation is done HERE, in the PLC, so the HMI can bind
         one native value map and run ZERO scripts - 89 scripted boxes re-evaluating on a clock tick is
         real load on the panel. Key property: with nothing faulted DispCode equals PosCode and simply
         never changes, so a healthy plant generates no tag traffic at all. Cost scales with the number
         of faults, not the number of valves. -->
    <Member Name="DispCode" Datatype="Array[1..89] of Int" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <!-- 0.25 Hz (2 s on / 2 s off) flash clock for DispCode. Deliberately slower than Clock_1Hz: a 2 s
         half-period needs only a ~1 s HMI acquisition cycle, so it cannot alias, and it quarters the
         update traffic when many valves are faulted. -->
    <Member Name="Clock_Flash" Datatype="Bool" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <Member Name="HwInitDone" Datatype="Bool" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <!-- Retentive mirror of Valve[i].Configured. Retentivity on an optimized DB is set per
         TOP-LEVEL member, and Configured lives inside Array[1..89] of "Valve_IO" - so it cannot
         be made retentive on its own. Marking the whole Valve array Retain was rejected: that
         array also holds OpenValve/CloseValve (the run latches) and both TON timers. A valve
         mid-stroke when the power failed would come back with its run latch still TRUE, and
         FC_IoMapper drives the real DQ from it - so the valve would restart on power-up with
         nobody commanding it. This mirror keeps the one flag that should survive and leaves the
         dangerous ones non-retentive. -->
    <Member Name="ConfiguredRet" Datatype="Array[1..89] of Bool" Remanence="Retain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <!-- Self-resetting 2 s tick driving Clock_Flash. -->
    <!-- Drives Clock_1Hz. Separate from FlashTmr because they run at different rates. -->
    <Member Name="Clk1Tmr" Datatype="TON_TIME" Version="1.0" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
