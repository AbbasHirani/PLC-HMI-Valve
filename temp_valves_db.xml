    <!-- 2-second hold before Loss of Position (E) fires: idle + uncommanded + neither limit made
         has to persist, or every legitimate stop-then-go transition would falsely alarm. Lives
         here in the DB (an array of the same TON_TIME type as Valve_IO's TimerOpen/TimerClose)
         rather than inside the Valve_IO UDT, so adding it doesn't touch every existing block that
         already uses that UDT. -->
    <Member Name="PosLostTmr" Datatype="Array[1..89] of TON_TIME" Version="1.0" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
