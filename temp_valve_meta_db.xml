      <Interface><Sections xmlns="http://www.siemens.com/automation/Openness/SW/Interface/v5">
  <Section Name="Static">
    <!-- Manually-maintained reference data, one entry per valve (V001..V088). Not written by
         any script or simulation — an engineer fills these in once via TIA's DB view (or online
         monitoring) after commissioning. Defaults to empty strings until populated. -->
    <Member Name="Name" Datatype="Array[1..88] of String[20]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <Member Name="Location" Datatype="Array[1..88] of String[20]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <!-- The client's own valve-schedule identity columns, added 2026-08-10 to match the format
         they actually issue lists in (CM No / Valve Tag / System / Location / Function).
         CmNo is STORED, not derived from the array index: the real schedule has gaps (no CM22)
         and runs past 88 (CM94..CM97), so slot number and CM number are genuinely different
         things. SysName likewise replaces the old index-range-derived zone string - a valve's
         system is schedule data, not something to infer from where it happens to sit in the array.
         Member names avoid SCL reserved words (FuncName not Function, SysName not System). -->
    <Member Name="CmNo" Datatype="Array[1..88] of String[6]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <Member Name="VTag" Datatype="Array[1..88] of String[12]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <Member Name="SysName" Datatype="Array[1..88] of String[12]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <Member Name="FuncName" Datatype="Array[1..88] of String[22]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <!-- Paged windows over the reference data above, mirroring the numeric windows in Valves_DB.
         FB_ValveLoop copies the displayed page's 14 entries here each scan so the HMI table can
         bind to fixed tag names instead of computing them per page in a script. These are written
         by the PLC, not by hand — the hand-maintained data is Name/Location above. -->
    <Member Name="AftTblName" Datatype="Array[1..14] of String[20]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <Member Name="ErTblName" Datatype="Array[1..14] of String[20]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <Member Name="FwdTblName" Datatype="Array[1..14] of String[20]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <Member Name="AftTblLoc" Datatype="Array[1..14] of String[20]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <Member Name="ErTblLoc" Datatype="Array[1..14] of String[20]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <Member Name="FwdTblLoc" Datatype="Array[1..14] of String[20]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <!-- Per-zone paged windows for the two identity columns the zone VALVE LIST tables show.
         CmNo replaces the old Valves_DB.*TblTag string, which was CONCAT'd from the array index
         ('CM-' + idx) and is now known to be wrong: the client's CM numbers skip values and run
         past 88, so an index-derived CM number mislabels most valves. Location is already
         mirrored above; System/Function aren't mirrored per zone because the zone tables don't
         show them (System is constant within a zone, Function lives on the valve popup). -->
    <Member Name="AftTblCmNo" Datatype="Array[1..14] of String[6]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <Member Name="ErTblCmNo" Datatype="Array[1..14] of String[6]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <Member Name="FwdTblCmNo" Datatype="Array[1..14] of String[6]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <Member Name="AftTblVTag" Datatype="Array[1..14] of String[12]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <Member Name="ErTblVTag" Datatype="Array[1..14] of String[12]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <Member Name="FwdTblVTag" Datatype="Array[1..14] of String[12]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <!-- Configuration screen's global (all-88) paged window - same mirroring pattern as the
         per-zone Aft/Er/FwdTblName/Loc above. -->
    <Member Name="CfgTblName" Datatype="Array[1..16] of String[20]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <Member Name="CfgTblLoc" Datatype="Array[1..16] of String[20]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <!-- Paged windows for the four new identity columns, same PLC-writes/HMI-binds-fixed-names
         pattern as CfgTblName/CfgTblLoc above. -->
    <Member Name="CfgTblCmNo" Datatype="Array[1..16] of String[6]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <Member Name="CfgTblVTag" Datatype="Array[1..16] of String[12]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <Member Name="CfgTblSys" Datatype="Array[1..16] of String[12]" Remanence="NonRetain" Accessibility="Public">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
    </Member>
    <Member Name="CfgTblFunc" Datatype="Array[1..16] of String[22]" Remanence="NonRetain" Accessibility="Public">
